# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
#   cp .env.example .env
#
# Never commit real secrets. Every value below is a placeholder.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signing key for JWTs. There is no default — the app cannot issue or verify
# tokens without it. Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string. The default matches the local Docker Postgres
# started by local_setup/docker-compose.yml.
PG_DATABASE_URL="postgresql://themecp:themecp@localhost:5432/themecp_v2"

# ---------------------------------------------------------------------------
# Codeforces integration
# ---------------------------------------------------------------------------

CODEFORCE_API_URL="https://codeforces.com/api"

# ---------------------------------------------------------------------------
# Auth / tokens
# ---------------------------------------------------------------------------

# 43200 minutes = 30 days.
ACCESS_TOKEN_EXPIRE_MINUTES="43200"
ALGORITHM="HS256"

# Required for administrative mutation endpoints such as POST /contest-theme.
# Must be independent of SECRET_KEY. When unset, those endpoints return 503.
ADMIN_API_TOKEN=""

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins. Credentials are enabled,
# so "*" is not a valid value here — list origins explicitly.
CORS_ALLOW_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Leaderboard
# ---------------------------------------------------------------------------
#
# All four are optional. Unset, blank, or non-numeric values fall back to the
# defaults shown here, so a typo cannot stop the service booting. They are read
# at startup, so a change needs a restart.

# Rows returned by GET /users/leaderboard when the caller omits ?limit=,
# and the largest value ?limit= will accept.
LEADERBOARD_DEFAULT_LIMIT="20"
LEADERBOARD_MAX_LIMIT="100"

# Contests a user must have finished before they are ranked. A first contest
# seeds the rating from the user's Codeforces rating, so a low value lets strong
# Codeforces competitors top the board without really using ThemeCP.
LEADERBOARD_MIN_CONTESTS="10"

# How recently a user must have finished a contest to stay listed. 183 days is
# about six months, matching the Codeforces convention.
LEADERBOARD_ACTIVE_WITHIN_DAYS="183"

# ---------------------------------------------------------------------------
# Runtime / observability
# ---------------------------------------------------------------------------

ENV="development"
LOG_LEVEL="INFO"
LOG_FORMAT="console"

# Leave empty to disable Sentry error reporting.
SENTRY_DSN=""
